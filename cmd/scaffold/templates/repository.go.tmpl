// Delete menghapus {{.Domain}}.
func (r *repository) Delete(ctx context.Context, id int64) error {
	const query = `DELETE FROM {{.Table}} WHERE id = $1`
	tag, err := r.pool.Exec(ctx, query, id)
	if err != nil {

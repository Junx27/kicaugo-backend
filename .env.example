# KicauGo Backend Environment Variables
# Copy to .env and adjust values

# Server
PORT=8080

# Database (PostgreSQL)
POSTGRES_USER=kicaugo
POSTGRES_PASSWORD=kicaugo
POSTGRES_DB=kicaugo
# DATABASE_URL is constructed from above in docker-compose.yml
# For manual use: DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
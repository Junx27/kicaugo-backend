// Repository menyimpan dan mencari {{.Domain}}.
type Repository interface {
	List(ctx context.Context) ([]entities.{{.DomainPascal}}, error)
	FindByID(ctx context.Context, id int64) (entities.{{.DomainPascal}}, error)
	Create(ctx context.Context, in entities.{{.DomainPascal}}) (entities.{{.DomainPascal}}, error)
	Update(ctx context.Context, id int64, in entities.{{.DomainPascal}}) (entities.{{.DomainPascal}}, error)
	Delete(ctx context.Context, id int64) error
}

// repository adalah implementasi Repository berbasis pgxpool.
type repository struct {
	pool *pgxpool.Pool
}

// NewRepository membuat repository dengan connection pool yang sudah ada.
func NewRepository(pool *pgxpool.Pool) Repository {
	return &repository{pool: pool}
}

// List mengambil semua {{.Domain}}.
func (r *repository) List(ctx context.Context) ([]entities.{{.DomainPascal}}, error) {
	const query = `SELECT id, {{.FieldColumns}}, created_at FROM {{.Table}} ORDER BY id`
	rows, err := r.pool.Query(ctx, query)
	if err != nil {
		return nil, fmt.Errorf("list {{.Domain}}: %w", err)
	}
	defer rows.Close()

	var out []entities.{{.DomainPascal}}
	for rows.Next() {
		var c entities.{{.DomainPascal}}
		if err := rows.Scan(&c.ID{{range .Fields}}, &c.{{.GoName}}{{end}}, &c.CreatedAt); err != nil {
			return nil, fmt.Errorf("scan {{.Domain}}: %w", err)
		}
		out = append(out, c)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("iterate {{.Domain}}: %w", err)
	}
	return out, nil
}

// FindByID mencari {{.Domain}} berdasarkan id.
func (r *repository) FindByID(ctx context.Context, id int64) (entities.{{.DomainPascal}}, error) {
	const query = `SELECT id, {{.FieldColumns}}, created_at FROM {{.Table}} WHERE id = $1`
	var c entities.{{.DomainPascal}}
	err := r.pool.QueryRow(ctx, query, id).
		Scan(&c.ID{{range .Fields}}, &c.{{.GoName}}{{end}}, &c.CreatedAt)
	if errors.Is(err, pgx.ErrNoRows) {
		return entities.{{.DomainPascal}}{}, apperrors.ErrNotFound
	}
	if err != nil {
		return entities.{{.DomainPascal}}{}, fmt.Errorf("find {{.Domain}} %d: %w", id, err)
	}
	return c, nil
}


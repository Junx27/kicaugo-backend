	return &service{repo: repo}
}

// List mengambil semua {{.Domain}}.
func (s *service) List(ctx context.Context) ([]entities.{{.DomainPascal}}, error) {
	return s.repo.List(ctx)
}

// GetByID mengambil {{.Domain}} berdasarkan id.
func (s *service) GetByID(ctx context.Context, id int64) (entities.{{.DomainPascal}}, error) {
	return s.repo.FindByID(ctx, id)
}

// Create membuat {{.Domain}} baru.
func (s *service) Create(ctx context.Context, in entities.{{.DomainPascal}}) (entities.{{.DomainPascal}}, error) {
	return s.repo.Create(ctx, in)
}

// Update memperbarui {{.Domain}}.
func (s *service) Update(ctx context.Context, id int64, in entities.{{.DomainPascal}}) (entities.{{.DomainPascal}}, error) {
	return s.repo.Update(ctx, id, in)
}

// Delete menghapus {{.Domain}}.
func (s *service) Delete(ctx context.Context, id int64) error {
	return s.repo.Delete(ctx, id)
